---
import Search from "../../components/Search.astro";
import IndexIcon from "../Icons/Index.astro";
import NavLink from "./NavLink.astro";

const pathname = new URL(Astro.request.url).pathname.replace(/\/+$/, "");

const isWithin = (path: string) =>
  pathname === path || pathname.startsWith(`${path}/`);

const links = [
  {
    href: "/docs",
    text: "🍓 Documentation",
    active: isWithin("/docs") && !isWithin("/docs/django"),
  },
  {
    href: "/changelog",
    text: "📜 Changelog",
    active: isWithin("/changelog") || isWithin("/release"),
  },
  {
    href: "/docs/django",
    text: "🦄 Strawberry Django",
    active: isWithin("/docs/django"),
  },
  {
    href: "https://github.com/strawberry-graphql/strawberry-sqlalchemy",
    text: "🧪 Strawberry SQLAlchemy",
  },
  {
    href: "/discord",
    text: "💬 Discord",
  },
];
---

<input type="checkbox" id="toggle-docs-nav" />

<aside class="docs-nav">
  <label for="toggle-docs-nav" class="docs-nav-toggle typography-label">
    <IndexIcon />

    Index
  </label>

  <div class="docs-nav-content">
    <Search />

    <ul>
      {
        links.map((link) => (
          <li>
            <NavLink {...link} />
          </li>
        ))
      }
    </ul>

    <slot />
  </div>
</aside>

<style>
  ul {
    margin-bottom: 32px;
    display: flex;
    gap: 16px;
    flex-direction: column;

    @media (min-width: 768px) {
      a {
        padding: 0 !important;
      }
    }
  }

  .docs-nav {
    scrollbar-width: thin;

    @media (max-width: 767px) {
      padding: 16px 16px 0;
    }
  }

  @media (min-width: 768px) {
    .docs-nav-toggle {
      display: none;
    }
  }
</style>
